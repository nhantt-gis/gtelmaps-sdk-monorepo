# Cấu hình cho docker-compose.yml cạnh file này.
# Chép thành `.env` rồi sửa:  cp docker/.env.example docker/.env
#
# Ở đây KHÔNG có biến nào của app. Vite nướng `import.meta.env.VITE_*` vào bundle
# lúc build, nhưng app này không dùng biến nào cả — style, tile, model đều đi qua
# đường dẫn gốc rồi được src/style.ts gắn `location.origin` lúc chạy. Nên mọi thứ
# dưới đây là núm của Docker, không phải của trang.

# ---- Docker ----
APP_IMAGE=10.0.0.21:8082/gis/gtelmaps/demo-3d-react:1.0.0-alpha.1
APP_NAME=gtelmaps-demo-3d-react
APP_PORT=8180

# ---- Dữ liệu tĩnh ----
# 31 MB sinh bằng scripts/, không nằm trong image và cũng không nằm trong git.
# Đường dẫn tính từ thư mục docker/.
PUBLIC_DIR=../public

TZ=Asia/Ho_Chi_Minh
