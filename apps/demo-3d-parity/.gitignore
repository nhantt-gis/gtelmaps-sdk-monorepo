# Sinh lại bằng `node scripts/build-tiles.mjs`; script mới là thứ đáng giữ,
# không phải output của nó.
public/tiles/
# Symlink tới dist của gl-js, dựng lại khi cần.
public/gl
# Sinh lại bằng `node scripts/build-sprite.mjs`.
public/sprite/
# Sinh lại bằng `node scripts/build-model-tiles.mjs`, cùng với các file .glb nó
# chép sang từ 3d-plugins. Mười một megabyte model không thuộc về repo này.
public/model-tiles/
public/models/
